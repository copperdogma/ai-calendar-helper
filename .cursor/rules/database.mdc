# Database Operations

## Quick Commands

### Schema Management
```bash
# Generate Prisma client
npx prisma generate

# Create and apply migration
npx prisma migrate dev --name description

# Reset database (destructive)
npx prisma migrate reset

# Deploy migrations to production
npx prisma migrate deploy

# Check migration status
npx prisma migrate status
```

### Database Development
```bash
# Open Prisma Studio (database GUI)
npx prisma studio

# Seed database with test data
npx prisma db seed

# Pull schema from database
npx prisma db pull

# Push schema changes without migration
npx prisma db push

# Validate schema file
npx prisma validate
```

### Database Testing
```bash
# Test database connection
npm run db:ping

# Run database-related tests
npm test -- --testPathPattern="prisma|database"

# Check database with health endpoint
curl http://localhost:3000/api/health
```

## Prisma Schema Patterns

### Model Definition
```prisma
model User {
  id             String    @id @default(uuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           UserRole  @default(USER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastSignedInAt DateTime?
  
  // Relations
  accounts       Account[]
  sessions       Session[]
  events         Event[]
  
  // Indexes for performance
  @@index([role])
  @@index([createdAt])
  @@index([email])
}
```

### Relationships
```prisma
// One-to-Many
model User {
  id       String    @id @default(uuid())
  events   Event[]
}

model Event {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// Many-to-Many
model User {
  id       String         @id @default(uuid())
  projects UserProject[]
}

model Project {
  id    String         @id @default(uuid())
  users UserProject[]
}

model UserProject {
  userId    String
  projectId String
  role      String
  user      User    @relation(fields: [userId], references: [id])
  project   Project @relation(fields: [projectId], references: [id])
  
  @@id([userId, projectId])
}
```

### Enums and Advanced Types
```prisma
enum UserRole {
  ADMIN
  USER
  MODERATOR
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model Event {
  id          String      @id @default(uuid())
  status      EventStatus @default(DRAFT)
  metadata    Json?       // JSON field for flexible data
  tags        String[]    // Array field
}
```

## Prisma Client Usage

### Basic CRUD Operations
```typescript
import { prisma } from '@/lib/prisma';

// Create
const user = await prisma.user.create({
  data: {
    email: 'user@example.com',
    name: 'John Doe',
    role: 'USER',
  },
});

// Read
const users = await prisma.user.findMany({
  where: {
    role: 'USER',
  },
  include: {
    events: true,
  },
  orderBy: {
    createdAt: 'desc',
  },
});

// Update
const updatedUser = await prisma.user.update({
  where: { id: userId },
  data: { lastSignedInAt: new Date() },
});

// Delete
await prisma.user.delete({
  where: { id: userId },
});
```

### Advanced Queries
```typescript
// Complex filtering
const events = await prisma.event.findMany({
  where: {
    AND: [
      { status: 'PUBLISHED' },
      { startDate: { gte: new Date() } },
      {
        OR: [
          { userId: currentUserId },
          { public: true },
        ],
      },
    ],
  },
  include: {
    user: {
      select: {
        id: true,
        name: true,
        email: true,
      },
    },
  },
});

// Aggregations
const stats = await prisma.event.aggregate({
  where: { userId: currentUserId },
  _count: { id: true },
  _avg: { duration: true },
  _max: { startDate: true },
});

// Group by
const eventsByStatus = await prisma.event.groupBy({
  by: ['status'],
  _count: { id: true },
  where: { userId: currentUserId },
});
```

### Transactions
```typescript
// Transaction with multiple operations
const result = await prisma.$transaction(async (tx) => {
  // Update user
  const user = await tx.user.update({
    where: { id: userId },
    data: { lastSignedInAt: new Date() },
  });

  // Create event
  const event = await tx.event.create({
    data: {
      title: 'New Event',
      userId: userId,
      startDate: new Date(),
    },
  });

  return { user, event };
});

// Transaction with rollback
try {
  await prisma.$transaction([
    prisma.user.update({
      where: { id: userId },
      data: { role: 'ADMIN' },
    }),
    prisma.auditLog.create({
      data: {
        action: 'ROLE_CHANGE',
        userId: userId,
        timestamp: new Date(),
      },
    }),
  ]);
} catch (error) {
  console.error('Transaction failed:', error);
  // Automatic rollback on error
}
```

## Migration Management

### Creating Migrations
```bash
# Create migration with descriptive name
npx prisma migrate dev --name add_user_preferences

# Create migration for specific changes
npx prisma migrate dev --name update_event_schema

# Create migration with SQL preview
npx prisma migrate diff --preview-feature
```

### Migration File Structure
```sql
-- CreateTable
CREATE TABLE "Event" (
    "id" TEXT NOT NULL,
    "title" TEXT NOT NULL,
    "description" TEXT,
    "startDate" TIMESTAMP(3) NOT NULL,
    "endDate" TIMESTAMP(3),
    "userId" TEXT NOT NULL,
    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
    "updatedAt" TIMESTAMP(3) NOT NULL,

    CONSTRAINT "Event_pkey" PRIMARY KEY ("id")
);

-- CreateIndex
CREATE INDEX "Event_userId_idx" ON "Event"("userId");
CREATE INDEX "Event_startDate_idx" ON "Event"("startDate");

-- AddForeignKey
ALTER TABLE "Event" ADD CONSTRAINT "Event_userId_fkey" 
    FOREIGN KEY ("userId") REFERENCES "User"("id") ON DELETE CASCADE ON UPDATE CASCADE;
```

### Custom Migration SQL
```sql
-- Custom migration for data transformation
UPDATE "User" SET "role" = 'USER' WHERE "role" IS NULL;

-- Add custom constraints
ALTER TABLE "Event" ADD CONSTRAINT "Event_date_check" 
    CHECK ("endDate" > "startDate");

-- Create custom indexes
CREATE INDEX CONCURRENTLY "Event_search_idx" ON "Event" 
    USING gin(to_tsvector('english', "title" || ' ' || COALESCE("description", '')));
```

## Connection Management

### Prisma Client Setup
```typescript
// lib/prisma.ts
import { PrismaClient } from '@prisma/client';

const globalForPrisma = globalThis as unknown as {
  prisma: PrismaClient | undefined;
};

export const prisma = globalForPrisma.prisma ?? new PrismaClient({
  log: ['query', 'error', 'warn'],
});

if (process.env.NODE_ENV !== 'production') {
  globalForPrisma.prisma = prisma;
}

// Connection lifecycle
export async function connectDatabase() {
  try {
    await prisma.$connect();
    console.log('Database connected successfully');
  } catch (error) {
    console.error('Database connection failed:', error);
    throw error;
  }
}

export async function disconnectDatabase() {
  await prisma.$disconnect();
}
```

### Connection Pooling
