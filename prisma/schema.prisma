generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           UserRole  @default(USER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastSignedInAt DateTime?
  calendarSyncStates CalendarSyncState[]
  settings          UserSettings?
  accounts       Account[]
  sessions       Session[]
  serviceUsage   ServiceUsage[]
  usageEvents    UsageEvent[]

  @@index([role])
  @@index([createdAt])
  @@index([updatedAt])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  USER
}

enum Service {
  CALENDAR_PARSER
  NOVEL_EVENTS_EXTRACTOR
}

model ServiceUsage {
  id        String   @id @default(uuid())
  userId    String
  service   Service
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, service])
}

/// ---------------------
/// Usage Analytics Models
/// ---------------------

enum InputType {
  TEXT
  IMAGE
  TEXT_IMAGE @map("TEXT+IMAGE")
}

enum DeviceType {
  MOBILE
  DESKTOP
}

enum CalendarAction {
  GOOGLE
  OUTLOOK
  ICS
}

model UsageEvent {
  id               String          @id @default(uuid())
  createdAt        DateTime        @default(now())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Event specifics
  inputType        InputType
  textSizeChars    Int?
  imageSizeBytes   Int?
  imageWidth       Int?
  imageHeight      Int?
  parseTimeMs      Int?
  eventsExtracted  Int?
  parseSuccess     Boolean?
  errorReason      String?

  // Client / device context
  deviceType       DeviceType
  os               String?
  browser          String?
  locale           String?

  // Post-parse action
  calendarAction   CalendarAction?

  @@index([createdAt])
  @@index([userId])
}

model CalendarSyncState {
  id        String   @id @default(uuid())
  userId    String
  calendarId String
  syncToken String?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, calendarId])
  @@index([userId])
}

model UserSettings {
  id               String   @id @default(uuid())
  userId           String   @unique
  lookAheadDays    Int      @default(14)
  noveltyThreshold Decimal  @default(0.2)
  autoBlacklist    Boolean  @default(true)
  blacklist        Json?
  whitelist        Json?
  storePattern     Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
